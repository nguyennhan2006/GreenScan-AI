# ==========================================================
# GreenScan — cấu hình. Chép tệp này thành .env
# (GreenScan.bat tự chép lần đầu). Không ghi chú cuối dòng:
# bộ đọc .env coi mọi thứ sau dấu = là giá trị.
# ==========================================================
#
# Chỉ cần chọn MỘT chế độ. Mỗi chế độ tự điền các biến còn lại;
# biến nào ghi rõ bên dưới thì luôn thắng chế độ.
#
#   offline  mọi laptop, không cần khoá API, tài liệu KHÔNG rời máy (mặc định).
#            Đo 05/10/2026 trên i7-1355U không GPU: BCPTBV + BCTN Hòa Phát
#            (264 trang) trong 116 s, RAM đỉnh 1,3 GB.
#   cloud    laptop + khoá FPT AI Marketplace. Mô hình chỉ đọc những cặp
#            tuyên bố–bằng chứng mà luật và phép tính không quyết được; câu trả
#            lời được lưu đệm nên chạy lại cùng tài liệu không gọi lại.
#            Đoạn văn của các cặp đó được GỬI RA NGOÀI: chỉ dùng cho tài liệu
#            công khai (FPT Serverless có thể xử lý ở Nhật khi quá tải).
#   gpu      máy chủ có GPU chạy mô hình mở bằng vLLM ở cổng 8001, BGE-M3 và
#            reranker trên CUDA. Dùng cho tài liệu mật.
#
# Chi tiết và số đo: docs/04-data-ai/MODEL_ROUTING_AND_HARDWARE.md

QUANTUM_PROFILE=offline

# Khoá FPT AI Marketplace — chỉ cần cho chế độ cloud.
# Lấy khoá tại https://marketplace.fptcloud.com rồi dán vào dòng dưới.
# URL đã có /v1 vì client tự nối /chat/completions.
FPT_LLM_BASE_URL=https://mkp-api.fptcloud.com/v1
FPT_LLM_API_KEY=
FPT_LLM_MODEL=GLM-5.2
FPT_LLM_API_FORMAT=openai_compatible
FPT_LLM_TIMEOUT_SECONDS=180
FPT_LLM_MAX_TOKENS=4096

# ==========================================================
# NÂNG CAO — bỏ dấu # để ghi đè chế độ đã chọn
# ==========================================================

# --- Ứng dụng
# QUANTUM_CONFIG=configs/default.yaml
# QUANTUM_RUNS_DIR=.quantum/runs
# QUANTUM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# QUANTUM_JOB_WORKERS=1

# --- OCR cho trang scan (cần cài Tesseract kèm gói tiếng Việt)
# QUANTUM_OCR_ENABLED=true
# QUANTUM_OCR_LANGUAGES=vie+eng
# QUANTUM_TESSERACT_COMMAND=tesseract

# --- Mô hình xét quan hệ tuyên bố–bằng chứng (verification/llm_judge.py)
# off          tất định hoàn toàn (bộ test luôn chạy ở đây)
# on_ambiguous chỉ hỏi mô hình khi luật từ khoá và phép so số đều không quyết
#              được; mọi kết luận của mô hình chuyển người xem, không bao giờ
#              ghi đè phép tính. Đo 28/09 trên HPG: 713/780 cặp, GLM-5.2 4–6 s/lần.
# QUANTUM_LLM_STANCE=off
# QUANTUM_LLM_WORKERS=8
# QUANTUM_LLM_CACHE_DIR=.quantum/llm_cache

# --- Nhà cung cấp và thứ tự dự phòng
# local | ollama | fpt | gemini | openai | anthropic | openrouter
# Mô hình theo từng việc nằm trong configs/routing.yaml (`models:`).
# LLM_PROVIDER=fpt
# LLM_FALLBACK_ORDER=fpt

# --- Mô hình chạy tại chỗ (vLLM ở cổng KHÁC 8000 — 8000 là cổng của GreenScan)
# Để trống URL = không dùng. Laptop không GPU: qwen3:8b qua Ollama mất 98 s/lần,
# không dùng được cho 700 cặp (đo 28/09).
#   vLLM:   LOCAL_LLM_PROVIDER=openai_compatible  LOCAL_LLM_BASE_URL=http://localhost:8001/v1
#   Ollama: LOCAL_LLM_PROVIDER=ollama             LOCAL_LLM_BASE_URL=http://localhost:11434  LOCAL_LLM_MODEL=qwen3:8b
# LOCAL_LLM_PROVIDER=openai_compatible
# LOCAL_LLM_BASE_URL=
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_MODEL=Qwen/Qwen3-8B
# LOCAL_LLM_TIMEOUT_SECONDS=180
# LOCAL_LLM_MAX_TOKENS=4096

# --- Truy xuất: vector và sắp xếp lại
# EMBEDDING_PROVIDER: lite (BM25 + n-gram, CPU) | fpt (Vietnamese_Embedding) | local (BGE-M3) | http (TEI)
# RERANKER_PROVIDER:  none | fpt (bge-reranker-v2-m3) | local | http
# Đo 29/09 trên laptop: BGE-M3 tại chỗ 0,49 trang/s; qua FPT 77,7 trang/s.
# Vietnamese_Embedding trên FPT ghi giấy phép CC-BY-NC-4.0 (phi thương mại).
# EMBEDDING_PROVIDER=lite
# FPT_EMBEDDING_MODEL=Vietnamese_Embedding
# LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
# LOCAL_EMBEDDING_DEVICE=cpu
# LOCAL_EMBEDDING_BATCH_SIZE=16
# EMBEDDING_BASE_URL=
# EMBEDDING_CACHE_DIR=.quantum/emb_cache
# RERANKER_PROVIDER=none
# FPT_RERANKER_MODEL=bge-reranker-v2-m3
# LOCAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# LOCAL_RERANKER_DEVICE=cpu
# RERANKER_BASE_URL=
# RERANK_CANDIDATE_K=30
# RERANK_FINAL_K=5

# --- Nhà cung cấp khác (dữ liệu xử lý ngoài Việt Nam: chỉ cho tài liệu công khai;
# không dùng gói miễn phí của Gemini — gói đó dùng dữ liệu để cải thiện sản phẩm)
# GEMINI_API_KEY=
# GEMINI_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
