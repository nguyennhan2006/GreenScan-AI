# ==========================================================
# PIPELINE
# ==========================================================

QUANTUM_CONFIG=configs/default.yaml
QUANTUM_RUNS_DIR=.quantum/runs
QUANTUM_LOG_LEVEL=INFO
QUANTUM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OCR
QUANTUM_OCR_ENABLED=true
QUANTUM_OCR_LANGUAGES=vie+eng
QUANTUM_TESSERACT_COMMAND=tesseract

# ==========================================================
# ACTIVE PROVIDER
# ==========================================================
# The application MUST start normally with every cloud key left empty.
# Local is the default; cloud providers are optional fallbacks.

LLM_PROVIDER=local

# local | fpt | gemini | openai | anthropic | openrouter
LLM_FALLBACK_ORDER=local,fpt,gemini,openai,anthropic

# ==========================================================
# LOCAL LLM
# ==========================================================
# vLLM (server/production):   LOCAL_LLM_PROVIDER=openai_compatible
#                             LOCAL_LLM_BASE_URL=http://localhost:8000/v1  (or http://vllm:8000/v1)
#                             LOCAL_LLM_MODEL=Qwen/Qwen3-8B
# Ollama (personal/dev):      LOCAL_LLM_PROVIDER=ollama
#                             LOCAL_LLM_BASE_URL=http://localhost:11434
#                             LOCAL_LLM_MODEL=qwen3:8b

LOCAL_LLM_PROVIDER=openai_compatible
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=Qwen/Qwen3-8B
LOCAL_LLM_TIMEOUT_SECONDS=180
LOCAL_LLM_MAX_TOKENS=4096

# ==========================================================
# LOCAL EMBEDDING
# ==========================================================
# lite = built-in char n-gram scorer (no download) | local = BGE-M3 | http = TEI service

EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_DEVICE=cuda
LOCAL_EMBEDDING_BATCH_SIZE=16
EMBEDDING_BASE_URL=

# ==========================================================
# LOCAL RERANKER
# ==========================================================
# none = keep retrieval order | local = bge-reranker-v2-m3 | http = TEI /rerank

RERANKER_PROVIDER=local
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LOCAL_RERANKER_DEVICE=cuda
RERANKER_BASE_URL=
RERANK_CANDIDATE_K=30
RERANK_FINAL_K=5

# ==========================================================
# FPT MARKETPLACE  (FPT AI Inference)
# ==========================================================
# OpenAI-compatible endpoint. Get a key at https://marketplace.fptcloud.com
# and paste it into FPT_LLM_API_KEY below -- nothing else needs to change.
#
# The base URL already carries /v1 because the shared OpenAI-compatible client
# appends /chat/completions to it. A URL without /v1 returns 404.
#
# Models confirmed on this account (2026-08-08). FPT_LLM_MODEL is only the
# DEFAULT; per-task choices live in configs/routing.yaml under `models:`.
#
#   Reasoning / chat
#     GLM-5.2                  largest here — used for legal_reasoning
#     Llama-3.3-70B-Instruct   strong Vietnamese prose — used for final_report
#     gpt-oss-120b             large open model
#     Qwen3.6-27B              good VI/EN balance — used for claim extraction
#     DeepSeek-V4-Flash        low latency — used for query generation
#     gemma-4-31B-it / gemma-4-26B-A4B-it / gemma-3-27b-it / gpt-oss-20b
#   Vision
#     Qwen2.5-VL-7B-Instruct   scanned pages, charts, hard table layouts
#   Embedding
#     Vietnamese_Embedding     Vietnamese-specific
#     multilingual-e5-large    multilingual baseline
#   Reranking
#     bge-reranker-v2-m3       same model configs/models_v1_1.yaml already locks
#   Speech (not used by this pipeline)
#     whisper-large-v3-turbo, FPT.AI-whisper-medium,
#     FPT.AI-whisper-large-v3-turbo, FPT.AI-VITs
#
# FPT_LLM_API_FORMAT: openai_compatible | fpt_native  (keep openai_compatible)

FPT_LLM_BASE_URL=https://mkp-api.fptcloud.com/v1
FPT_LLM_API_KEY=
FPT_LLM_MODEL=Qwen3.6-27B
FPT_LLM_API_FORMAT=openai_compatible
FPT_LLM_TIMEOUT_SECONDS=180
FPT_LLM_MAX_TOKENS=4096

# Embedding and reranking can also run on FPT instead of downloading weights.
# Set EMBEDDING_PROVIDER=http / RERANKER_PROVIDER=http above, then point them here.
# bge-reranker-v2-m3 is the exact reranker the locked V1.1 model set names, so
# this is a hosted swap rather than a change of model.
FPT_EMBEDDING_MODEL=Vietnamese_Embedding
FPT_RERANKER_MODEL=bge-reranker-v2-m3

# ==========================================================
# GEMINI
# ==========================================================

GEMINI_API_KEY=
GEMINI_MODEL=

# ==========================================================
# OPENAI
# ==========================================================

OPENAI_API_KEY=
OPENAI_MODEL=

# ==========================================================
# ANTHROPIC
# ==========================================================

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ==========================================================
# OPENROUTER
# ==========================================================

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
