{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "pair_id",
    "company_id",
    "claim_id",
    "evidence_id",
    "retrieval_score",
    "label"
  ],
  "properties": {
    "label": {
      "enum": [
        "",
        "supported",
        "partially_supported",
        "contradicted",
        "insufficient_evidence",
        "not_relevant"
      ]
    }
  }
}